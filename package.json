{
  "name": "margin",
  "version": "0.4.0",
  "private": true,
  "description": "Local AI code review with chat — review branches and uncommitted changes before they leave your machine.",
  "license": "MIT",
  "author": "Chris Ruslim",
  "productName": "Margin",
  "type": "module",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.cruslim.margin",
    "productName": "Margin",
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "build/icon.png"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac",
    "review": "tsx scripts/review.ts",
    "chat": "tsx scripts/chat.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "install-app": "node scripts/install-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "@git-diff-view/react": "^0.1.6",
    "dompurify": "^3.4.12",
    "fix-path": "^5.0.0",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
